# ---- Secrets (NEVER commit) ----
backend/.env
backend/.env.*
backend/serviceAccount*.json
**/serviceAccount*.json
*-firebase-adminsdk-*.json
RENDER_ENV_VALUES.txt

# ---- Android release signing (NEVER commit — losing these = can't update app) ----
**/*.jks
**/*.keystore
**/key.properties

# ---- Node ----
**/node_modules/
*.log

# ---- Flutter/Dart (app/ also has its own .gitignore) ----
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
**/*.iml

# ---- OS ----
.DS_Store
Thumbs.db

# Video build scratch (regenerate with scripts/build-video.mjs)
listing-content/video/.work/

# Promo audio scratch (regenerate with scripts/build_promo_audio.py)
listing-content/video/.audio/

# Video tooling deps (npm i in listing-content/)
listing-content/node_modules/

# Google Ads creatives: the 99 MB of rendered MP4s are build output --
# build_videos.py plus source-recordings/ reproduces them exactly. The
# recordings and screenshots themselves ARE tracked: they were captured off a
# physical device in a particular app state and cannot be regenerated.
marketing/google-ads/videos/**/*.mp4
marketing/google-ads/.video-build/
marketing/google-ads/.vo-build/
marketing/google-ads/.music/
marketing/google-ads/.v2-build/
marketing/google-ads/.ref/
